{
  "version": 1,
  "project": "CitSciAnalysis",
  "project_url": "https://github.com/ColinOrionChandler/CitSciAnalysis",
  "repo": "..",
  "branches": [
    "main"
  ],
  "show_commit_url": "https://github.com/ColinOrionChandler/CitSciAnalysis/commit/",
  "environment_type": "virtualenv",
  "pythons": [
    "3.12"
  ],
  "matrix": {
    "build": []
  },
  "benchmark_dir": ".",
  "env_dir": "env",
  "results_dir": "_results",
  "html_dir": "_html",
  "build_command": [
    "python -m build --wheel -o {build_cache_dir} {build_dir}"
  ],
  "install_command": [
    "python -m pip install {wheel_file}"
  ],
  "build_cache_size": 8
}
